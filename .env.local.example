# ============================================================
# SUPABASE — Récupérez ces valeurs sur https://supabase.com
# Project Settings > API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service (uniquement pour les routes API serveur — ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# ADMINISTRATION — Mot de passe admin (côté serveur uniquement)
# ============================================================
ADMIN_PASSWORD=votre-mot-de-passe-admin-securise

# ============================================================
# ÉGLISE — Nom affiché sur la plateforme
# ============================================================
NEXT_PUBLIC_CHURCH_NAME=Église de la Grâce

# ============================================================
# PAIEMENTS — Numéros de réception des fonds
# ============================================================
# Wave : numéro ou identifiant marchand
NEXT_PUBLIC_WAVE_PHONE=0700000000
NEXT_PUBLIC_WAVE_MERCHANT_ID=

# MTN Mobile Money
NEXT_PUBLIC_MTN_PHONE=0700000000

# Orange Money
NEXT_PUBLIC_ORANGE_PHONE=0700000000

# Montant minimum accepté (en FCFA)
NEXT_PUBLIC_MIN_AMOUNT=100
